<Page x:Class="akaszto.SugoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:akaszto"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="400"
      Title="SugoPage"
      Background="AliceBlue">

    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Súgó" FontWeight="Bold" FontSize="32" HorizontalAlignment="Center"/>
            <TextBlock Text="A játék célja, hogy kitaláld a titkos szót. Ehhez betűket tippelhetsz. Ha a tippelt betű szerepel a szóban, akkor az megjelenik a megfelelő helyen. Ha nem szerepel, akkor egy hibát kapsz. A játék addig tart, amíg ki nem találod a szót, vagy el nem éred a maximális hibaszámot." FontSize="16" TextWrapping="Wrap" Margin="0,20,0,0"/>
            <Button BorderBrush="Black" Height="40" Width="100" Background="BlanchedAlmond" Content="Vissza" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" Click="Back_Click"/>

        </StackPanel>
    </Grid>
</Page>
