<Window x:Class="akaszto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:akaszto"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="400"
        Background="AliceBlue">
    <Grid>
        <StackPanel Margin="10">

            
            <TextBlock Text="Akasztófa" FontWeight="Bold" FontSize="32" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="Consolas" FontSize="24" HorizontalAlignment="Center" Margin="0,30,0,0">
    <Run x:Name="Fej" Text=""/><LineBreak/>
    <Run x:Name="Balkez" Text=""/><Run x:Name="Test1" Text=""/><Run x:Name="Jobbkez" Text=""/><LineBreak/>
    <Run x:Name="Test2" Text=""/><LineBreak/>
    <Run x:Name="Ballab" Text=""/> <Run x:Name="Jobblab" Text=""/>
            </TextBlock>
            
            <TextBlock x:Name="SzoHelye" Text="" FontSize="24" HorizontalAlignment="Center" Margin="0,20,0,0"/>

            <TextBlock x:Name="TippeltBetuk" Text="Tippelt betűk:" FontSize="16" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            <TextBlock x:Name="Hibak" Text="Hibák száma: 0/6" FontSize="16" HorizontalAlignment="Left" Margin="0,10,0,0"/>


            <TextBlock Text="Adj meg egy betűt:" FontSize="24" HorizontalAlignment="Center" Margin="0,30,0,0"/>
            <TextBox x:Name="TippText" FontSize="24" HorizontalAlignment="Center" Height="34" Width="34" Margin="0,10,0,0" HorizontalContentAlignment="Center"/>
            <Button BorderBrush="Black" Height="40" Width="100" Background="CornflowerBlue" x:Name="Tipp" Content="Tipp" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" Click="Tipp_Click"/>



            <Button BorderBrush="Black" Height="40" Width="100" Background="IndianRed" Content="Új játék" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,100,0,0" Click="UjJatek_Click"/>
            <Button BorderBrush="Black" Height="40" Width="100" Background="PaleGreen" Content="Súgó" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" Click="Sugo_Click"/>
            



        </StackPanel>

        <Frame x:Name="mainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
